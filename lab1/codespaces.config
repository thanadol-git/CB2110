// Caps every process to what a GitHub Codespaces 4-core/16GB machine actually has.
// Nextflow clamps any process directive that exceeds these values down to the limit,
// it does not force smaller processes up to it.
process {
    resourceLimits = [
        cpus: 4,
        memory: 14.GB,
        time: 48.h
    ]
}

// `nextflow run -bg` detaches the run so there's no live progress bar in the terminal
// to watch. These reports get written to disk as the run progresses, so `tail -f` or
// re-opening execution_report.html is how you check on a background run instead.
timeline {
    enabled = true
    file    = "results/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "results/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "results/pipeline_info/execution_trace.txt"
}
